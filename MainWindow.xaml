<Window x:Class="SharePermissionsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 共享与 NTFS 权限迁移大师 (精简独立版 v6.4)" Height="780" Width="1120" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 页签 1：预检与健康诊断 -->
            <TabItem Header="🔍 迁移前预检与诊断">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Content=" 运行合规预检与诊断 " Padding="15,6" FontWeight="Bold" Click="BtnRunCheck_Click"/>
                        <TextBlock Text="（检查系统权限、WMI 接口、孤儿 SID 及共享可访问性）" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                    </StackPanel>

                    <TextBox Name="txtCheckLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="#F9F9F9" Padding="8"/>
                </Grid>
            </TabItem>

            <!-- 页签 2：导出迁移包 -->
            <TabItem Header="📦 一键导出权限包">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="选择要导出的目标共享文件夹" Grid.Row="0" Margin="0,0,0,10" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox Name="lstExportShares" Grid.Column="0" Height="100"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button Content="全选" Width="60" Margin="0,0,0,4" Click="BtnSelectAllExportShares_Click"/>
                                <Button Content="全不选" Width="60" Click="BtnClearAllExportShares_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="导出与账号策略选项" Grid.Row="1" Padding="10">
                        <StackPanel>
                            <CheckBox Name="chkExportUsers" Content="导出本地用户 (Local Users) 与 账号元数据" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox Name="chkExportGroups" Content="导出本地组 (Local Groups) 与 组成员所属关系" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox Name="chkExportShares" Content="导出 SMB 共享网络配置" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox Name="chkExportNTFS" Content="导出 NTFS 显式 ACL 权限树 (深度扫描子目录)" IsChecked="True" Margin="0,0,12,0"/>

                            <Separator Margin="0,5,0,12"/>

                            <!-- 密码策略配置 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="新系统重建账号初始密码:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Name="txtDefaultPassword" Text="P@ssword123" Width="130" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="chkPasswordNeverExpires" Content="设置新建账号密码永不过期" IsChecked="True" Margin="0,0,20,0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <Button Name="btnExportPackage" Grid.Row="2" Content=" 📦 打包导出完整迁移包 (.pkg.json) " Padding="20,8" Margin="0,10,0,0" FontWeight="Bold" HorizontalAlignment="Right" Click="BtnExportPackage_Click"/>
                </Grid>
            </TabItem>

            <!-- 页签 3：还原与路径重映射 -->
            <TabItem Header="🔄 一键恢复与路径重映射">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Content=" 📂 加载迁移包 (.pkg.json) " Padding="12,5" FontWeight="Bold" Click="BtnLoadPackage_Click"/>
                        <TextBlock Name="lblLoadedPkgInfo" Text="尚未加载迁移包" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="DarkBlue" FontWeight="SemiBold"/>
                    </StackPanel>

                    <GroupBox Header="共享文件夹路径重映射表 (双击新路径列可修改，支持换盘符恢复)" Grid.Row="1" Margin="0,0,0,10">
                        <DataGrid Name="dgPathMapping" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="共享名称" Binding="{Binding ShareName}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="原始物理路径" Binding="{Binding SourcePath}" Width="280" IsReadOnly="True"/>
                                <DataGridTextColumn Header="新系统目标物理路径 (可编辑)" Binding="{Binding TargetPath}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Name="chkRestoreUsers" Content="自动重建用户与组关系" IsChecked="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <CheckBox Name="chkRestoreShares" Content="重建 SMB 共享配置" IsChecked="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <CheckBox Name="chkRestoreACLs" Content="应用 NTFS ACL 权限" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Button Name="btnStartRestore" Content=" 🚀 开始一键恢复与还原 " Padding="20,8" FontWeight="Bold" IsEnabled="False" Click="BtnStartRestore_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 页签 4：迁移审计报告 -->
            <TabItem Header="📊 迁移结果审计报告">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Content=" 📄 导出员工初始密码与权限通知单 (CSV) " Padding="12,5" FontWeight="Bold" Click="BtnExportUserNotice_Click"/>
                        <Button Content=" 导出 HTML 完整审计报告 " Padding="12,5" Margin="10,0,0,0" Click="BtnExportHtmlReport_Click"/>
                        <Button Content=" 导出 CSV 详细日志 " Padding="12,5" Margin="10,0,0,0" Click="BtnExportCsvLog_Click"/>
                    </StackPanel>

                    <TextBox Name="txtAuditLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="#F0F8FF" Padding="8"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="1" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock Name="lblStatus" Text="就绪" Foreground="Blue"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
